# Pedrozilla - mozconfig para compilar el fork sobre Firefox 156 (Windows x64).
#
# Uso:
#   1. Deja el fuente en D:\mozilla\firefox-156.0.1 (ver fork/README.md).
#   2. Copia este archivo como "mozconfig" (sin extension) en la raiz del fuente,
#      o exporta la variable MOZCONFIG con su ruta.
#   3. Copia fork/branding/pedrozilla a browser/branding/pedrozilla del fuente.
#   4. ./mach build   (desde MozillaBuild shell)

ac_add_options --enable-application=browser
ac_add_options --target=x86_64-pc-mingw32
ac_add_options --host=x86_64-pc-mingw32

# Marca propia (directorio fork/branding/pedrozilla copiado al fuente).
ac_add_options --with-branding=browser/branding/pedrozilla

# Nombre de aplicacion: perfil, remoting y binario propios (pedrozilla.exe).
# (MOZ_APP_NAME deriva en minusculas de MOZ_APP_BASENAME; se fija igual
# explicitamente para no depender de ese detalle.)
ac_add_options --with-app-basename=Pedrozilla
ac_add_options --with-app-name=pedrozilla

# Identidad propia: proveedor y ID de aplicacion (informe de fallos, Sync,
# formato de perfil). El ID es un UUID generado para Pedrozilla.
export MOZ_APP_VENDOR=Pedrozilla
export MOZ_APP_ID={a3f2c1e0-5b4d-4a8e-9c0d-1e2f3a4b5c6d}

# Compilacion fuera del arbol de fuentes.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-pedrozilla

# Release optimizada.
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests

# Sin actualizador propio en la primera version.
ac_add_options --disable-updater
